{
  "compilerOptions": {
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declaration": true,
    // 同 `tsconfig.build.json`：TS 6 不再自动加载 `@types/node`。
    "types": ["node"],
    "outDir": "dist",
  },
}