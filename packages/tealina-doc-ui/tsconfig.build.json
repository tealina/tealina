{
  "compilerOptions": {
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declaration": true,
    // TS 6 起 `types` 默认为空，`@types/node` 不再自动进程序；`src/index.ts` 要读
    // `node:fs/promises`、`node:path`、`node:url`。
    "types": ["node"],
    // TS 6 起 `rootDir` 不再推断为输入的公共目录，而是固定为 tsconfig 所在目录——不写的
    // 话产物会多一层 `dist/src/`，而 `package.json` 的 `types` 指着 `dist/index.d.ts`。
    "rootDir": "src",
    "outDir": "dist",
  },
  "include": [
    "src"
  ]
}