{
  "name": "tealina",
  "version": "2.2.2",
  "description": "A CLI for build end-to-end typesafety APIs, and code, types, document generation",
  "license": "MIT",
  "author": "Neo Yeo",
  "bin": {
    "tealina": "index.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./utility-types": {
      "types": "./dist/utility-types.d.ts"
    }
  },
  "scripts": {
    "gen-types": "tsc src/index.ts src/utility-types.ts --ignoreConfig --strict false --declaration --emitDeclarationOnly --esModuleInterop --outDir dist",
    "build": "rm -rf dist && vp pack && pnpm gen-types",
    "test": "vp test --dir ./test --run --testTimeout=20000"
  },
  "dependencies": {
    "@tealina/doc-types": "workspace:*",
    "@tealina/utility-types": "workspace:*",
    "cac": "^6.7.14",
    "chalk": "^5.2.0",
    "consola": "^3.2.3",
    "esbuild": "^0.25.9",
    "fp-lite": "^2.0.0",
    "openapi-types": "^12.1.3",
    "pathe": "^1.1.1",
    "tealina": "link:"
  },
  "peerDependencies": {
    "typescript": ">=5.6.2 <7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
