{
  "name": "@tealina/client",
  "version": "1.0.3",
  "description": "Parse tealina-server type for client.",
  "keywords": [
    "api-client",
    "rpc-api-client",
    "tealina",
    "type-safe-client"
  ],
  "license": "MIT",
  "author": "Neo Yeo",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./axios": {
      "import": "./dist/axios.js",
      "types": "./dist/axios.d.ts"
    },
    "./fetch": {
      "import": "./dist/fetch.js",
      "types": "./dist/fetch.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "test": "vp test --run"
  },
  "dependencies": {
    "@tealina/utility-types": "workspace:*"
  },
  "devDependencies": {
    "axios": "^1.7.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
